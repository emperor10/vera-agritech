# Vera AgriTech — Apache config for HostAfrica cPanel shared hosting.
# This file is copied into dist/ on every build and must sit in the same
# public_html directory as index.html.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Never rewrite real files/directories, or the reverse-proxied API paths
  # (see docs/DEPLOYMENT.md for how /api and /uploads are wired to the
  # Node.js backend on HostAfrica's cPanel "Setup Node.js App").
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^api/ - [L]
  RewriteRule ^uploads/ - [L]

  # Every other route is handled client-side by React Router.
  RewriteRule ^ index.html [L]
</IfModule>

# Basic security headers.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Cache hashed static assets aggressively; never cache index.html.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
<FilesMatch "index\.html$">
  Header set Cache-Control "no-cache"
</FilesMatch>
