# Base URL of the backend API. In local development the Vite dev server
# proxies /api and /uploads to http://localhost:4000 (see vite.config.ts),
# so this can be left blank locally.
#
# In production on HostAfrica, set this to the public URL of the Node.js
# backend, e.g. https://api.veraagritech.com/api or https://veraagritech.com/api
VITE_API_URL=/api
