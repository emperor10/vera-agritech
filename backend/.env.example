# Server
PORT=4000
NODE_ENV=production

# Public URL of this API. On Render this is your service URL, e.g.
# https://vera-agritech-backend.onrender.com
APP_URL=http://localhost:4000

# Comma-separated list of origins allowed to call this API (your frontend
# domain(s)). Use * only for local development.
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=change-this-to-a-long-random-string-before-deploying
JWT_EXPIRES_IN=8h

# Default admin account, created automatically the first time the database
# is initialised (npm run db:seed). CHANGE THE PASSWORD IMMEDIATELY AFTER
# your first login in production.
DEFAULT_ADMIN_NAME=Vera AgriTech Admin
DEFAULT_ADMIN_EMAIL=admin@veraagritech.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# --- Database (libSQL) ---
# Local development, or any host with real persistent disk storage (e.g.
# HostAfrica): a local file, no account needed. Point this at a writable
# directory outside the web root, e.g.
#   DATABASE_URL=file:/home/<cpanel-user>/vera-backend/data/vera.sqlite3
DATABASE_URL=file:./data/vera.sqlite3
# DATABASE_AUTH_TOKEN is not needed for a local file: URL.

# On a host with NO persistent disk (e.g. Render's free tier), point at a
# free Turso database instead, so your data survives restarts/redeploys.
#   1. Sign up free at https://turso.tech (no credit card required)
#   2. Create a database, then get its URL and an auth token (the Turso
#      dashboard's "Connect" panel shows both, or use the Turso CLI:
#      `turso db show <db-name> --url` and `turso db tokens create <db-name>`)
#   3. Set these two instead of the file: URL above:
# DATABASE_URL=libsql://<your-db-name>-<your-org>.turso.io
# DATABASE_AUTH_TOKEN=<token from turso db tokens create>

# --- Uploaded images ---
# 'local' saves uploads to disk (UPLOADS_DIR below) and serves them from
# this app at /uploads — only safe on a host with real persistent storage
# (e.g. HostAfrica). Do NOT use 'local' on Render's free tier or similar —
# uploaded images would be wiped on every restart.
IMAGE_STORAGE=local
UPLOADS_DIR=./uploads

# 'cloudinary' uploads instead to a free Cloudinary account, so images
# survive restarts/redeploys even without a persistent disk. Use this on
# Render (or any ephemeral host): set IMAGE_STORAGE=cloudinary and fill in:
#   1. Sign up free at https://cloudinary.com (no credit card required)
#   2. Your cloud name, API key and API secret are shown on your Cloudinary
#      dashboard home page immediately after signing up.
# IMAGE_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=vera-agritech

# Rate limiting
LOGIN_RATE_LIMIT_MAX=10
FORM_RATE_LIMIT_MAX=20
