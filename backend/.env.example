# Server
PORT=4000
NODE_ENV=production

# Public URL of this API (used to build absolute upload URLs). In production
# on HostAfrica this should be the domain/subdomain the Node.js app is
# reachable on, e.g. https://api.veraagritech.com or https://veraagritech.com/api
APP_URL=http://localhost:4000

# Comma-separated list of origins allowed to call this API (your frontend
# domain(s)). Use * only for local development.
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=change-this-to-a-long-random-string-before-deploying
JWT_EXPIRES_IN=8h

# Default admin account, created automatically the first time the database
# is initialised (npm run db:seed). CHANGE THE PASSWORD IMMEDIATELY AFTER
# your first login in production.
DEFAULT_ADMIN_NAME=Vera AgriTech Admin
DEFAULT_ADMIN_EMAIL=admin@veraagritech.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# SQLite database file location (relative to backend/ or absolute path).
# On HostAfrica, point this at a writable directory outside the web root,
# e.g. /home/<cpanel-user>/data/vera.sqlite3
DATABASE_FILE=./data/vera.sqlite3

# Directory where uploaded images are stored (must be writable).
UPLOADS_DIR=./uploads

# Rate limiting
LOGIN_RATE_LIMIT_MAX=10
FORM_RATE_LIMIT_MAX=20
